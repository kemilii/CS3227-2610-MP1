<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         styleClass="dialog-box"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         stylesheets="@../css/dialog-box.css">
    <children>
        <Label fx:id="dialog" styleClass="dialog-label" text="Label" wrapText="true" minHeight="-Infinity">
            <HBox.margin>
                <Insets left="7.0" right="7.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
            </padding>
        </Label>
        <ImageView fx:id="displayPicture"
                   fitHeight="34.0"
                   fitWidth="34.0"
                   styleClass="bot-avatar"
                   pickOnBounds="true"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="15.0" left="5.0" right="5.0" top="15.0" />
    </padding>
</fx:root>
